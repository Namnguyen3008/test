# Copy to .env locally. Never commit real secrets.

APP_ENV=development
APP_DATA_MODE=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Secret value must be supplied outside Git.
GEMINI_API_KEY=

# Exact generative model allowlist and deterministic rotation.
GEMINI_GENERATIVE_MODEL_1=gemini-3.1-flash-lite
GEMINI_GENERATIVE_MODEL_2=gemini-3.5-flash-lite
GEMINI_GENERATIVE_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_GENERATIVE_ROUTING_MODE=redis_round_robin
GEMINI_ROUND_ROBIN_REDIS_KEY=vmec:gemini:generative:round_robin:v1
GEMINI_CALL_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS_PER_MODEL=2
GEMINI_FAILOVER_ENABLED=true
GEMINI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GEMINI_CIRCUIT_BREAKER_RECOVERY_SECONDS=60
GEMINI_TEMPERATURE=0.1

# Exact embedding models. Never mix their vector spaces.
GEMINI_EMBEDDING_PRIMARY_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TEXT_FALLBACK_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_DISTANCE=cosine
GEMINI_EMBEDDING_BUILD_PRIMARY=true
GEMINI_EMBEDDING_BUILD_TEXT_FALLBACK=true

RAG_LEXICAL_TOP_K=40
RAG_PRIMARY_VECTOR_TOP_K=40
RAG_FALLBACK_VECTOR_TOP_K=40
RAG_FUSED_TOP_K=15
RAG_CONTEXT_TOP_K=6
RAG_RRF_K=60

DATABASE_URL=postgresql+psycopg://vmec:vmec@postgres:5432/vmec
REDIS_URL=redis://redis:6379/0
SESSION_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

FIELD_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=
CSRF_SECRET=
METRICS_TOKEN=

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
