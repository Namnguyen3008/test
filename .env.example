# VMEC-01 local configuration. Copy to .env; never commit real values.
APP_ENV=development
APP_DATA_MODE=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

GEMINI_API_KEY=
GEMINI_GENERATIVE_MODEL_1=gemini-3.1-flash-lite
GEMINI_GENERATIVE_MODEL_2=gemini-3.5-flash-lite
GEMINI_GENERATIVE_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_GENERATIVE_ROUTING_MODE=redis_round_robin
GEMINI_ROUND_ROBIN_REDIS_KEY=vmec:gemini:generative:round_robin:v1
GEMINI_CALL_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS_PER_MODEL=2

GEMINI_EMBEDDING_PRIMARY_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TEXT_FALLBACK_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

DATABASE_URL=postgresql+psycopg://vmec:vmec@localhost:5432/vmec
REDIS_URL=redis://localhost:6379/0
SESSION_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

FIELD_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=
CSRF_SECRET=
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# External AI-log submission is disabled and must remain off for PHI-bearing workloads.
VMEC_AI_LOG_EXTERNAL_SUBMISSION_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:8000
