# =======================================================
# CONFIGURATION FOR VMEC AGENT MICROSERVICE & COCKROACHDB CLOUD
# =======================================================

# 1. Gemini API Key (Required for LLM generation)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. CockroachDB Cloud Vector Database Connection String
# Get this from https://cockroachlabs.cloud/ (Free Serverless Cluster)
COCKROACH_DATABASE_URL=postgresql://username:password@cluster-name.gcp-asia-southeast1.cockroachlabs.cloud:26257/vmec?sslmode=verify-full

# 3. Environment & Server Settings
APP_ENV=production
PORT=8000
