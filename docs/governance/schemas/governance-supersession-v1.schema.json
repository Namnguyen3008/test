{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmec.example.invalid/schemas/governance-supersession-v1.schema.json",
  "title": "VMEC governance supersession v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "project_id", "route_name", "expected_generation", "reason", "effective_at", "owner_authorization", "issued_at", "expires_at", "signature", "previous", "replacement", "clinical_scope_changed", "clinical_attestations"],
  "properties": {
    "schema_version": {"const": "vmec.governance-supersession.v1"},
    "artifact_id": {"type": "string", "minLength": 8},
    "project_id": {"const": "VMEC-01"},
    "route_name": {"const": "vmec-production-v1"},
    "expected_generation": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 8},
    "effective_at": {"type": "string", "format": "date-time"},
    "owner_authorization": {"$ref": "#/$defs/owner"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "signature": {"$ref": "#/$defs/signature"},
    "previous": {"$ref": "#/$defs/binding"},
    "replacement": {"$ref": "#/$defs/binding"},
    "clinical_scope_changed": {"type": "boolean"},
    "clinical_attestations": {"type": "array", "items": {"$ref": "#/$defs/reviewer"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "production_release_id", "promotion_receipt_digest", "clinical_scope_digest"],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 8},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "production_release_id": {"type": "string", "minLength": 8},
        "promotion_receipt_digest": {"$ref": "#/$defs/digest"},
        "clinical_scope_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "authorization_reference", "authorized_at"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "authorization_reference": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value_base64"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/digest"},
        "value_base64": {"type": "string", "minLength": 40}
      }
    },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_id", "organization", "authorization_reference", "scope", "decision", "reviewed_at"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 3},
        "organization": {"type": "string", "minLength": 2},
        "authorization_reference": {"type": "string", "minLength": 3},
        "scope": {"type": "array", "minItems": 1, "items": {"enum": ["ALL_APPROVED_RELEASE_ROWS", "SAFETY_CRITICAL_AND_GOLD_CANDIDATES"]}},
        "decision": {"const": "APPROVE"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
